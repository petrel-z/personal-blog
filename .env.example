# Database
DATABASE_URL="mysql://user:password@localhost:3306/blog"

# Redis
REDIS_URL="redis://localhost:6379"

# Search: false ignores IP headers and shares one quota for direct requests.
# Enable only behind a proxy that overwrites X-Real-IP and blocks direct access to Next.js.
SEARCH_TRUST_PROXY="false"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
# Auth.js v5 also uses AUTH_URL to configure its trusted origin.
AUTH_URL="http://localhost:3000"

# Optional: AI Summary
# GEMINI_API_KEY="your-gemini-api-key"

# Storage (local or oss)
# STORAGE_PROVIDER="local"  # local or oss
# OSS Configuration (when STORAGE_PROVIDER="oss")
# OSS_ACCESS_KEY_ID="your-access-key-id"
# OSS_ACCESS_KEY_SECRET="your-access-key-secret"
# OSS_BUCKET="your-bucket-name"
# OSS_REGION="oss-cn-wulanchabu"
# OSS_ENDPOINT="oss-cn-wulanchabu.aliyuncs.com"
# OSS_CDN_DOMAIN="https://your-cdn-domain.com"  # Optional CDN domain
